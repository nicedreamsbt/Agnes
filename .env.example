# Solana RPC used for the initial full snapshot and any SDK refreshes.
RPC_URL=https://api.mainnet-beta.solana.com

# Yellowstone / Dragon's Mouth gRPC endpoint and auth token.
GRPC_ENDPOINT=https://api.rpcpool.com:443
GRPC_X_TOKEN=

# marginfi SDK environment: production, mainnet, dev, or staging depending on SDK config support.
MARGINFI_ENV=production

# Optional: process only a comma-separated subset of marginfi account pubkeys.
# Empty means preload and monitor all marginfi accounts in the group.
MARGINFI_ACCOUNTS=

# Optional: print accounts affected by specific marginfi bank venues only.
# Use all, or any comma-separated subset of: marginfi,kamino,juplend,drift,unknown.
# Health is still computed from the full marginfi account because cross-venue collateral/debt shares one account.
VENUES=all

# Optional commitment. Common values: processed, confirmed, finalized.
GRPC_COMMITMENT=processed

# Re-fetch oracle prices through the SDK after oracle gRPC updates. This keeps health calculations
# aligned with SDK oracle parsing while still using gRPC as the update trigger.
REFRESH_ORACLES_ON_UPDATE=true

# Periodic full SDK market refresh in milliseconds. Set 0 to disable.
MARKET_REFRESH_MS=60000

# Print every discovered bank and its oracle setup/keys on startup and market refresh.
PRINT_BANK_CATALOG=true

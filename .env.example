# --- Required for most flows ---
# Solana HTTP RPC (snapshot, SDK refresh, verify-account, smoke tools)
RPC_URL=https://api.mainnet-beta.solana.com

# Project Zero / marginfi SDK environment (see @0dotxyz/p0-ts-sdk getConfig)
# production | staging | staging-mainnet-clone | staging-alt
MARGINFI_ENV=production

# Optional overrides (defaults come from MARGINFI_ENV)
# MARGINFI_PROGRAM_ID=MFv2hWf31Z9kbCa1snEPYctwafyhdvnV7FZnsebVacA
# MARGINFI_GROUP_PK=4qp6Fx6tnZkY5Wropq9wUYgtFxXKwE6viZxFHg3rdAG8

# --- Yellowstone gRPC (monitor live stream; harmless placeholder for verify if unused) ---
GRPC_ENDPOINT=
GRPC_X_TOKEN=

# Optional: extra oracle **program** ids for Yellowstone owner filters (comma-separated)
# GRPC_ORACLE_OWNER_PROGRAMS=

# --- Monitor tuning (when using src/monitor.js) ---
# MARGINFI_ACCOUNTS=
# COMMITMENT=processed
# VENUES=all
# PRINT_BANK_CATALOG=true
# REFRESH_ORACLES_ON_UPDATE=true
# Tee monitor stdout/stderr (append). Parent dir is created automatically.
# LOG_FILE=logs/monitor.log

# GRPC_SUBSCRIBE_SLOTS=false
# GRPC_LOG_SLOT_UPDATES=false
# GRPC_LOG_ACCOUNT_UPDATE_SLOT=false
# Keep false for large groups: owner filter already streams all marginfi accounts; explicit list duplicates ~500k+ pubkeys.
# GRPC_SUBSCRIBE_EXPLICIT_ACCOUNTS=false

# CATALOG_MODE=auto
# CATALOG_SUMMARY_THRESHOLD=500
# RPC_PRELOAD_MARGINFI_ACCOUNTS=false
# RPC_PRELOAD_MAX_ACCOUNTS=50000
# RPC_PRELOAD_CONCURRENCY=16
# RPC_PRELOAD_CHUNK_SIZE=100
# RPC_PRELOAD_PROGRESS_INTERVAL_MS=1000
# RPC_PRELOAD_USE_GPA=true
# On-disk raw account cache (set to empty string to disable). Warm restarts skip most preload RPC.
# AGNES_MARGINFI_ACCOUNT_CACHE_FILE=.cache/marginfi-accounts.json
# AGNES_MARGINFI_ACCOUNT_CACHE_SAVE_DEBOUNCE_MS=30000

# --- Liquidation smoke / Jupiter ---
# Keypair JSON path (or place liquidator.json in cwd — gitignored)
AGNES_WALLET_KEYPAIR_PATH=

# Classic marginfi flash envelope: set liquidator marginfi account pubkey
# AGNES_LIQUIDATOR_MARGINFI_ACCOUNT=

# FLASH_LOAN_PROVIDER=marginfi

# JUPITER_SWAP_API_BASE=https://lite-api.jup.ag/swap/v2
# JUPITER_API_KEY=
# JUPITER_MAX_ACCOUNTS=28
# JUPITER_ONLY_DIRECT_ROUTES=false
# JUPITER_EXCLUDE_DEXES=

# AGNES_COMPUTE_UNIT_LIMIT=1400000
# AGNES_COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=0
# AGNES_USE_MARGINFI_DEFAULT_LUTS=true
# AGNES_USE_SUPPLEMENTAL_LIQUIDATION_LUTS=true

# Extra v0 lookup tables (comma-separated). ADDRESS_LOOKUP_TABLES is an alias.
# AGNES_LOOKUP_TABLES=
# ADDRESS_LOOKUP_TABLES=

# Override default Eva01 trio classification (comma-separated); leave unset for built-in defaults
# EVA_LOOKUP_TABLES=

# --- Safety ---
# AGNES_ALLOW_SEND=false

# --- Candidate / freshness thresholds ---
# MAX_ACCOUNT_LAG_SLOTS=100000
# MAX_BANK_LAG_SLOTS=100000
# MAX_ORACLE_LAG_SLOTS=100000
# MAX_INTEGRATION_LAG_SLOTS=100000
# STRICT_INTEGRATION_FRESHNESS=false
# AGNES_MIN_DEBT_USD=0
# AGNES_MIN_ABS_HEALTH_USD=0
# AGNES_MIN_BONUS_USD=0

# AGNES_LIQ_DEBUG=false
# AGNES_LIQ_DEBUG_VERBOSE=false

# --- Liquidation smoke harness (npm run liq:smoke) ---
# Dry-run by default. Live submit requires LIQ_SMOKE_DRY_RUN=false AND LIQ_SMOKE_ALLOW_LIVE_SUBMIT=true.
# LIQ_SMOKE_ENABLED=false
# LIQ_SMOKE_DRY_RUN=true
# LIQ_SMOKE_TARGET_ACCOUNT=
# LIQ_SMOKE_PROTOCOL=marginfi
# LIQ_SMOKE_ALLOW_LIVE_SUBMIT=false
# LIQ_SMOKE_USE_JITO=true
# LIQ_SMOKE_USE_RPC_BACKUP=true
# LIQ_SMOKE_FORCE_ORACLE_CRANK=false
# LIQ_SMOKE_MAX_REPAY_USD=5
# LIQ_SMOKE_MIN_PROFIT_USD=0
# LIQ_SMOKE_LOG_DIR=logs/liquidations/smoke
# Hermes base URL (must end with host; client appends /v2/...). Example: https://hermes.pyth.network
# LIQ_SMOKE_HERMES_BASE_URL=https://hermes.pyth.network
# Hermes Beta fallback when primary returns broken/missing feed ids (oracle crank build).
# LIQ_SMOKE_HERMES_FALLBACK_URL=https://hermes-beta.pyth.network
# Switchboard On-Demand gateway override (optional; SDK auto-discovers when unset).
# LIQ_SMOKE_SWITCHBOARD_GATEWAY_URL=
# LIQ_SMOKE_SWITCHBOARD_NUM_SIGNATURES=3
# Jito block engine origin (no trailing path). Example: https://mainnet.block-engine.jito.wtf
# LIQ_SMOKE_JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Tip lamports appended to liquidation tx when Jupiter did not return a tip ix (Jito bundles require a tip).
# LIQ_SMOKE_JITO_TIP_LAMPORTS=10000
# Optional fixed tip account (otherwise random from getTipAccounts).
# LIQ_SMOKE_JITO_TIP_ACCOUNT=
